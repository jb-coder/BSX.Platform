{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "BSX.Platform"
    }
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Identity": {
    "Database": {
      "ApplyMigrationsOnStartup": false,
      "VerifySchema": false
    },
    "Permissions": {
      "SynchronizeOnStartup": true
    }
  },
  "Crm": {
    "Database": {
      "VerifySchema": false
    }
  },
  "Sales": {
    "Database": {
      "VerifySchema": false
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
