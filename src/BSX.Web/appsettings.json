{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "BSX.Platform"
    }
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Outbox": {
    "Enabled": true,
    "ProcessingEnabled": true,
    "IntegrationPublishingEnabled": false,
    "PollInterval": "00:00:05",
    "BatchSize": 100,
    "MaxRetryCount": 10,
    "BaseBackoff": "00:00:05",
    "StaleProcessingAfter": "00:05:00"
  },
  "Identity": {
    "Database": {
      "ApplyMigrationsOnStartup": false,
      "VerifySchema": false
    },
    "Permissions": {
      "SynchronizeOnStartup": true
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "LockoutDurationMinutes": 15
    }
  },
  "DataProtection": {
    "ApplicationName": "BSX.Platform",
    "KeysPath": ""
  },
  "ReverseProxy": {
    "Enabled": true,
    "RedirectHttpToHttps": true,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Hsts": {
    "MaxAge": "365.00:00:00",
    "IncludeSubDomains": true,
    "Preload": false
  },
  "SecurityHeaders": {
    "ReferrerPolicy": "no-referrer",
    "PermissionsPolicy": "camera=(), microphone=(), geolocation=()"
  },
  "Crm": {
    "Database": {
      "VerifySchema": false
    }
  },
  "Sales": {
    "Database": {
      "VerifySchema": false
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
