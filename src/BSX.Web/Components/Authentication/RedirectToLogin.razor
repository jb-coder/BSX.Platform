@inject NavigationManager Navigation

<LoadingState Label="Redirecting to sign in..." />

@code {
    protected override void OnInitialized()
    {
        string relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        string returnUrl = "/" + relative.TrimStart('/');
        Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}", replace: true);
    }
}
