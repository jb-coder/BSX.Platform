@inject NavigationManager Navigation
@inject BSX.Web.Authentication.WebSessionState SessionState

<LoadingState Label="Redirecting to sign in..." />

@code {
    protected override void OnInitialized()
    {
        string relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        string returnUrl = "/" + relative.TrimStart('/');
        string expired = SessionState.Expired ? "&expired=true" : string.Empty;
        Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}{expired}", replace: true);
    }
}
