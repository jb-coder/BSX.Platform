@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<a class="skip-link" href="#main-content">Skip to main content</a>

<div class="app-shell">
    <aside id="app-sidebar" class="app-sidebar @(_navigationOpen ? "is-open" : null)" aria-label="Application sidebar">
        <Brand />
        <NavMenu OnNavigate="CloseNavigation" />
        <div class="sidebar-footer">
            <span>BSX Platform</span>
            <span class="sidebar-version">Foundation</span>
        </div>
    </aside>

    @if (_navigationOpen)
    {
        <div class="app-sidebar-overlay" @onclick="CloseNavigation"></div>
    }

    <div class="app-main">
        <AppHeader NavigationOpen="_navigationOpen" OnToggleNavigation="ToggleNavigation" />
        <main id="main-content" class="app-content" tabindex="-1">
            @Body
        </main>
    </div>
</div>

<ToastHost />

<div id="blazor-error-ui" data-nosnippet>
    An unexpected error occurred.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss">Dismiss</button>
</div>

@code {
    private bool _navigationOpen;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => CloseNavigation();

    private void ToggleNavigation() => _navigationOpen = !_navigationOpen;

    private void CloseNavigation() => _navigationOpen = false;
}
