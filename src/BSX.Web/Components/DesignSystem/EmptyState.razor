<div class="empty-state" role="status">
    <div class="empty-state-mark" aria-hidden="true"></div>
    <h2>@Title</h2>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p>@Description</p>
    }
    @if (Action is not null)
    {
        <div class="empty-state-action">@Action</div>
    }
</div>

@code {
    /// <summary>The empty-state title.</summary>
    [Parameter]
    public string Title { get; set; } = "Nothing here yet";

    /// <summary>An optional explanation.</summary>
    [Parameter]
    public string? Description { get; set; }

    /// <summary>An optional action such as a create button.</summary>
    [Parameter]
    public RenderFragment? Action { get; set; }
}
