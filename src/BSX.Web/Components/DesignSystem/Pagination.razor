@if (TotalPages > 1)
{
    <nav class="pagination" aria-label="Pagination">
        @if (PageHrefFactory is null)
        {
            <button type="button"
                    class="button button-secondary"
                    disabled="@(Page <= 1)"
                    @onclick="Previous">
                Previous
            </button>
        }
        else
        {
            <a class="button button-secondary @(Page <= 1 ? "is-disabled" : null)"
               href="@(Page <= 1 ? null : PageHrefFactory(Page - 1))"
               aria-disabled="@(Page <= 1 ? "true" : "false")">
                Previous
            </a>
        }

        <span class="pagination-status" aria-current="page">Page @Page of @TotalPages</span>

        @if (PageHrefFactory is null)
        {
            <button type="button"
                    class="button button-secondary"
                    disabled="@(Page >= TotalPages)"
                    @onclick="Next">
                Next
            </button>
        }
        else
        {
            <a class="button button-secondary @(Page >= TotalPages ? "is-disabled" : null)"
               href="@(Page >= TotalPages ? null : PageHrefFactory(Page + 1))"
               aria-disabled="@(Page >= TotalPages ? "true" : "false")">
                Next
            </a>
        }
    </nav>
}

@code {
    /// <summary>The current one-based page.</summary>
    [Parameter]
    public int Page { get; set; } = 1;

    /// <summary>The page size.</summary>
    [Parameter]
    public int PageSize { get; set; } = 20;

    /// <summary>The total number of items.</summary>
    [Parameter]
    public int TotalCount { get; set; }

    /// <summary>Raised when the page changes in interactive mode.</summary>
    [Parameter]
    public EventCallback<int> PageChanged { get; set; }

    /// <summary>
    /// An optional page URL factory. When supplied, the current page is rendered as links for
    /// server-rendered GET paging instead of event-driven buttons.
    /// </summary>
    [Parameter]
    public Func<int, string>? PageHrefFactory { get; set; }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalCount / (double)Math.Max(1, PageSize)));

    private Task Previous() => PageChanged.InvokeAsync(Page - 1);

    private Task Next() => PageChanged.InvokeAsync(Page + 1);
}
