@page "/forgot-password"
@layout AuthLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using Microsoft.AspNetCore.Components

<PageTitle>Forgot password - BSX Platform</PageTitle>

<div class="auth-page auth-page-single">
    <section class="auth-card" aria-labelledby="forgot-password-title">
        <Brand />
        <div class="auth-card-heading">
            <p class="eyebrow">Account recovery</p>
            <h1 id="forgot-password-title">Forgot your password?</h1>
            <p>Enter the email address for your BSX account. If an account exists, we will send a password-reset link.</p>
        </div>

        @if (Sent)
        {
            <div class="alert alert-success" role="status">
                Check your inbox. If an account exists for that email address, a reset link has been sent.
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <div class="alert alert-error" role="alert">@StatusMessage</div>
        }

        @if (!Sent)
        {
            <form method="post" action="/auth/password-reset/request" class="auth-form">
                <AntiforgeryToken />

                <div class="field">
                    <label for="email">Email address</label>
                    <input id="email"
                           name="email"
                           type="email"
                           autocomplete="email"
                           inputmode="email"
                           maxlength="320"
                           required
                           autofocus />
                </div>

                <button type="submit" class="button button-primary button-full">Send reset link</button>
            </form>
        }

        <p class="auth-help">
            <a href="/login">Back to sign in</a>
        </p>
    </section>
</div>

@code {
    /// <summary>Whether the request was accepted for processing.</summary>
    [SupplyParameterFromQuery(Name = "sent")]
    public bool Sent { get; set; }

    /// <summary>A non-sensitive request error key.</summary>
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private string? StatusMessage => Error switch
    {
        "invalid_email" => "Enter a valid email address.",
        "too_many_requests" => "Too many reset requests. Try again in a minute.",
        "unavailable" => "Password recovery is unavailable right now. Contact your workspace administrator.",
        "invalid_request" => "The request was invalid. Please try again.",
        "request_failed" => "The reset request could not be processed. Please try again.",
        _ => null,
    };
}
