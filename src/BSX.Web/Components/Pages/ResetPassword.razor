@page "/reset-password"
@layout AuthLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using Microsoft.AspNetCore.Components

<PageTitle>Reset password - BSX Platform</PageTitle>

<div class="auth-page auth-page-single">
    <section class="auth-card" aria-labelledby="reset-password-title">
        <Brand />
        <div class="auth-card-heading">
            <p class="eyebrow">Account recovery</p>
            <h1 id="reset-password-title">Choose a new password</h1>
            @if (CanReset)
            {
                <p>Use at least 8 characters. Your existing sessions will be signed out after the reset.</p>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <div class="alert alert-error" role="alert">@StatusMessage</div>
        }

        @if (CanReset)
        {
            <form method="post" action="/auth/password-reset/complete" class="auth-form">
                <AntiforgeryToken />
                <input type="hidden" name="token" value="@Token" />

                <div class="field">
                    <label for="new-password">New password</label>
                    <input id="new-password"
                           name="newPassword"
                           type="password"
                           autocomplete="new-password"
                           minlength="8"
                           required
                           autofocus />
                </div>

                <div class="field">
                    <label for="confirm-password">Confirm new password</label>
                    <input id="confirm-password"
                           name="confirmPassword"
                           type="password"
                           autocomplete="new-password"
                           minlength="8"
                           required />
                </div>

                <button type="submit" class="button button-primary button-full">Reset password</button>
            </form>
        }
        else
        {
            <a class="button button-primary button-full" href="/forgot-password">Request a new reset link</a>
        }

        <p class="auth-help">
            <a href="/login">Back to sign in</a>
        </p>
    </section>
</div>

@code {
    /// <summary>The reset token supplied by the email link.</summary>
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    /// <summary>A non-sensitive reset error key.</summary>
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private bool IsTokenUnusable => Error is "expired" or "used" or "invalid_token";

    private bool CanReset => !string.IsNullOrWhiteSpace(Token) && !IsTokenUnusable;

    private string? StatusMessage => Error switch
    {
        "expired" => "This password-reset link has expired. Request a new link to continue.",
        "used" => "This password-reset link has already been used. Request a new link if you still need to reset your password.",
        "invalid_token" => "This password-reset link is invalid. Request a new link to continue.",
        "password_required" => "Enter a new password.",
        "password_mismatch" => "The two passwords do not match.",
        "password_rule" => "Choose a stronger password with at least 8 characters.",
        "invalid_request" => "The reset request was invalid. Please try again.",
        "reset_failed" => "The password could not be reset. Request a new link and try again.",
        _ when string.IsNullOrWhiteSpace(Token) => "This password-reset link is invalid. Request a new link to continue.",
        _ => null,
    };
}
