@page "/Error"
@layout AuthLayout
@using System.Diagnostics

<PageTitle>Error - BSX Platform</PageTitle>

<div class="auth-page auth-page-single">
    <section class="auth-card auth-card-wide" aria-labelledby="error-title">
        <Brand />
        <div class="auth-card-heading">
            <p class="eyebrow">Unexpected error</p>
            <h1 id="error-title">Something went wrong</h1>
            <p>We could not complete that request. Try again, or return to your workspace.</p>
        </div>
        @if (ShowRequestId)
        {
            <p class="muted-text">Reference: <code>@RequestId</code></p>
        }
        <a class="button button-primary" href="/">Go to your workspace</a>
    </section>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
        => RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
