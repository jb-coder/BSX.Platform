@page "/app/crm/customers/{CustomerId:guid}/contacts/new"
@attribute [Authorize(Policy = PermissionPolicies.CrmCustomersUpdate)]
@using BSX.BuildingBlocks.Cqrs
@using BSX.Modules.Crm.Application.Contacts.AddContact
@using BSX.Modules.Crm.Application.Customers.GetCustomerById
@using BSX.Modules.Crm.Application.Dtos
@using BSX.SharedKernel.Results
@using Microsoft.AspNetCore.Http
@inject ISender Sender
@inject WebCurrentUser CurrentUser
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IToastService Toasts
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Add contact - BSX Platform</PageTitle>

@if (_loading)
{
    <LoadingState Label="Loading customer..." />
}
else if (_customer is null)
{
    <PageHeader Title="Customer not found"
                Subtitle="The customer may have been removed or may belong to another workspace." />

    <Card>
        <EmptyState Title="Customer not found"
                    Description="Return to the customer list to choose another record.">
            <Action>
                <a class="button button-primary" href="/app/crm/customers">Back to customers</a>
            </Action>
        </EmptyState>
    </Card>
}
else
{
    <PageHeader Title="Add contact"
                Subtitle="@($"Add a contact person to {_customer.Name}.")">
        <Actions>
            <a class="button button-secondary" href="@($"/app/crm/customers/{_customer.Id}")">Cancel</a>
        </Actions>
    </PageHeader>

    <div class="content-medium">
        @if (_error is not null)
        {
            <div class="alert alert-error" role="alert">
                <strong>Contact could not be added.</strong>
                <span>@_error</span>
            </div>
        }

        @if (!_customerActive)
        {
            <Card>
                <EmptyState Title="Customer is not active"
                            Description="Contacts can be added only while the customer is active." />
            </Card>
        }
        else
        {
            <Card>
                <EditForm Model="Form" OnValidSubmit="CreateAsync">
                    <DataAnnotationsValidator />
                    <ContactFormFields Model="Form" ShowPrimary="true" />

                    <div class="form-actions">
                        <button type="submit" class="button button-primary" disabled="@_saving">
                            @(_saving ? "Adding..." : "Add contact")
                        </button>
                        <a class="button button-secondary" href="@($"/app/crm/customers/{_customer.Id}")">
                            Cancel
                        </a>
                    </div>
                </EditForm>
            </Card>
        }
    </div>
}

@code {
    private CustomerDto? _customer;
    private string? _error;
    private bool _loading = true;
    private bool _saving;
    private bool _customerActive;

    /// <summary>The customer identifier.</summary>
    [Parameter]
    public Guid CustomerId { get; set; }

    /// <summary>The contact form model.</summary>
    public ContactFormModel Form { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CurrentUser.SetPrincipal(state.User);

        Result<CustomerDto> result = await Sender.SendAsync(new GetCustomerByIdQuery(CustomerId));
        _loading = false;

        if (result.IsFailure)
        {
            if (result.Error.Code == "CRM.Customer.NotFound" && HttpContextAccessor.HttpContext is { } context)
            {
                context.Response.StatusCode = StatusCodes.Status404NotFound;
            }

            return;
        }

        _customer = result.Value;
        _customerActive = string.Equals(_customer.Status, "Active", StringComparison.OrdinalIgnoreCase);
    }

    private async Task CreateAsync()
    {
        if (_saving || _customer is null)
        {
            return;
        }

        _saving = true;
        _error = null;

        Result result = await CrmWebResults.ExecuteAsync(() => Sender.SendAsync(
            new AddContactCommand(
                _customer.Id,
                Form.Name,
                Form.Email,
                Form.PhoneNumber,
                Form.IsPrimary)));

        _saving = false;

        if (result.IsFailure)
        {
            _error = CrmCustomerMessages.For(result.Error);
            return;
        }

        Toasts.Success("Contact added", $"The contact was added to {_customer.Name}.");
        Navigation.NavigateTo($"/app/crm/customers/{_customer.Id}");
    }
}
