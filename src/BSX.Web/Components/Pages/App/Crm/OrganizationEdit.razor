@page "/app/crm/organizations/{Id:guid}/edit"
@attribute [Authorize(Policy = PermissionPolicies.CrmOrganizationsUpdate)]
@using BSX.BuildingBlocks.Cqrs
@using BSX.Modules.Crm.Application.Dtos
@using BSX.Modules.Crm.Application.Organizations.GetOrganizationById
@using BSX.Modules.Crm.Application.Organizations.UpdateOrganization
@using BSX.SharedKernel.Results
@using Microsoft.AspNetCore.Http
@inject ISender Sender
@inject WebCurrentUser CurrentUser
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IToastService Toasts
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Edit organization - BSX Platform</PageTitle>

@if (_loading)
{
    <LoadingState Label="Loading organization..." />
}
else if (_organization is null)
{
    <PageHeader Title="Organization not found"
                Subtitle="The organization may have been removed or may belong to another workspace." />

    <Card>
        <EmptyState Title="Organization not found"
                    Description="Return to the organization list to choose another record.">
            <Action>
                <a class="button button-primary" href="/app/crm/organizations">Back to organizations</a>
            </Action>
        </EmptyState>
    </Card>
}
else
{
    <PageHeader Title="@($"Edit {_organization.Name}")"
                Subtitle="Update the organization details and optional primary address.">
        <Actions>
            <a class="button button-secondary" href="@($"/app/crm/organizations/{_organization.Id}")">Cancel</a>
        </Actions>
    </PageHeader>

    <div class="content-medium">
        @if (_error is not null)
        {
            <div class="alert alert-error" role="alert">
                <strong>Changes could not be saved.</strong>
                <span>@_error</span>
                @if (_conflict)
                {
                    <a href="@($"/app/crm/organizations/{_organization.Id}/edit")">Reload organization</a>
                }
            </div>
        }

        <Card>
            <EditForm Model="Form" OnValidSubmit="UpdateAsync">
                <DataAnnotationsValidator />
                <OrganizationFormFields Model="Form" />

                <div class="form-actions">
                    <button type="submit" class="button button-primary" disabled="@_saving">
                        @(_saving ? "Saving..." : "Save changes")
                    </button>
                    <a class="button button-secondary" href="@($"/app/crm/organizations/{_organization.Id}")">
                        Cancel
                    </a>
                </div>
            </EditForm>
        </Card>
    </div>
}

@code {
    private OrganizationDto? _organization;
    private string? _error;
    private bool _loading = true;
    private bool _saving;
    private bool _conflict;

    /// <summary>The organization identifier.</summary>
    [Parameter]
    public Guid Id { get; set; }

    /// <summary>The organization form model.</summary>
    public OrganizationFormModel Form { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CurrentUser.SetPrincipal(state.User);

        Result<OrganizationDto> result = await Sender.SendAsync(new GetOrganizationByIdQuery(Id));
        _loading = false;

        if (result.IsFailure)
        {
            if (result.Error.Code == "CRM.Organization.NotFound" && HttpContextAccessor.HttpContext is { } context)
            {
                context.Response.StatusCode = StatusCodes.Status404NotFound;
            }

            return;
        }

        _organization = result.Value;
        Form = ToForm(_organization);
    }

    private async Task UpdateAsync()
    {
        if (_saving || _organization is null)
        {
            return;
        }

        _saving = true;
        _error = null;
        _conflict = false;

        Result result = await CrmWebResults.ExecuteAsync(() => Sender.SendAsync(
            new UpdateOrganizationCommand(
                Id,
                Form.Name,
                Form.TaxIdentifier,
                Form.ToAddressInput())));

        _saving = false;

        if (result.IsFailure)
        {
            _conflict = result.Error.Code == "CRM.ConcurrencyConflict";
            _error = CrmCustomerMessages.For(result.Error);
            return;
        }

        Toasts.Success("Organization saved", "The organization details were updated.");
        Navigation.NavigateTo($"/app/crm/organizations/{Id}");
    }

    private static OrganizationFormModel ToForm(OrganizationDto organization)
    {
        AddressDto? address = organization.Address;

        return new OrganizationFormModel
        {
            Name = organization.Name,
            TaxIdentifier = organization.TaxIdentifier,
            IncludeAddress = address is not null,
            AddressLine1 = address?.Line1,
            AddressLine2 = address?.Line2,
            City = address?.City,
            Region = address?.Region,
            PostalCode = address?.PostalCode,
            Country = address?.Country,
        };
    }
}
