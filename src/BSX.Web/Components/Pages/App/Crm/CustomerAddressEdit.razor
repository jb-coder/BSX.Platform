@page "/app/crm/customers/{CustomerId:guid}/addresses/{AddressId:guid}/edit"
@attribute [Authorize(Policy = PermissionPolicies.CrmCustomersUpdate)]
@using BSX.BuildingBlocks.Cqrs
@using BSX.Modules.Crm.Application.Addresses.UpdateAddress
@using BSX.Modules.Crm.Application.Common
@using BSX.Modules.Crm.Application.Customers.GetCustomerById
@using BSX.Modules.Crm.Application.Dtos
@using BSX.SharedKernel.Results
@using Microsoft.AspNetCore.Http
@inject ISender Sender
@inject WebCurrentUser CurrentUser
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IToastService Toasts
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Edit address - BSX Platform</PageTitle>

@if (_loading)
{
    <LoadingState Label="Loading address..." />
}
else if (_customer is null || _address is null)
{
    <PageHeader Title="Address not found"
                Subtitle="The customer or address may have been removed." />

    <Card>
        <EmptyState Title="Address not found"
                    Description="Return to the customer to choose another address.">
            <Action>
                <a class="button button-primary" href="/app/crm/customers">Back to customers</a>
            </Action>
        </EmptyState>
    </Card>
}
else
{
    <PageHeader Title="Edit address"
                Subtitle="@($"Update the {_address.Type.ToLowerInvariant()} address for {_customer.Name}.")">
        <Actions>
            <a class="button button-secondary" href="@($"/app/crm/customers/{_customer.Id}")">Cancel</a>
        </Actions>
    </PageHeader>

    <div class="content-medium">
        @if (_error is not null)
        {
            <div class="alert alert-error" role="alert">
                <strong>Changes could not be saved.</strong>
                <span>@_error</span>
                @if (_conflict)
                {
                    <a href="@($"/app/crm/customers/{_customer.Id}/addresses/{AddressId}/edit")">
                        Reload address
                    </a>
                }
            </div>
        }

        <Card>
            <EditForm Model="Form" OnValidSubmit="UpdateAsync">
                <DataAnnotationsValidator />
                <AddressFormFields Model="Form" />

                <div class="form-actions">
                    <button type="submit" class="button button-primary" disabled="@_saving">
                        @(_saving ? "Saving..." : "Save changes")
                    </button>
                    <a class="button button-secondary" href="@($"/app/crm/customers/{_customer.Id}")">
                        Cancel
                    </a>
                </div>
            </EditForm>
        </Card>
    </div>
}

@code {
    private CustomerDto? _customer;
    private AddressDto? _address;
    private string? _error;
    private bool _loading = true;
    private bool _saving;
    private bool _conflict;

    /// <summary>The customer identifier.</summary>
    [Parameter]
    public Guid CustomerId { get; set; }

    /// <summary>The address identifier.</summary>
    [Parameter]
    public Guid AddressId { get; set; }

    /// <summary>The address form model.</summary>
    public AddressFormModel Form { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CurrentUser.SetPrincipal(state.User);

        Result<CustomerDto> result = await Sender.SendAsync(new GetCustomerByIdQuery(CustomerId));
        _loading = false;

        if (result.IsFailure)
        {
            if (result.Error.Code == "CRM.Customer.NotFound" && HttpContextAccessor.HttpContext is { } context)
            {
                context.Response.StatusCode = StatusCodes.Status404NotFound;
            }

            return;
        }

        _customer = result.Value;
        _address = _customer.Addresses.FirstOrDefault(address => address.Id == AddressId);

        if (_address is null)
        {
            if (HttpContextAccessor.HttpContext is { } context)
            {
                context.Response.StatusCode = StatusCodes.Status404NotFound;
            }

            return;
        }

        Form = new AddressFormModel
        {
            Type = _address.Type,
            Line1 = _address.Line1,
            Line2 = _address.Line2,
            City = _address.City,
            Region = _address.Region,
            PostalCode = _address.PostalCode,
            Country = _address.Country,
        };
    }

    private async Task UpdateAsync()
    {
        if (_saving || _customer is null || !Form.TryGetAddressType(out CrmAddressType type))
        {
            return;
        }

        _saving = true;
        _error = null;
        _conflict = false;

        Result result = await CrmWebResults.ExecuteAsync(() => Sender.SendAsync(
            new UpdateAddressCommand(
                _customer.Id,
                AddressId,
                Form.ToAddressInput(),
                type)));

        _saving = false;

        if (result.IsFailure)
        {
            _conflict = result.Error.Code == "CRM.ConcurrencyConflict";
            _error = CrmCustomerMessages.For(result.Error);
            return;
        }

        Toasts.Success("Address saved", "The address was updated.");
        Navigation.NavigateTo($"/app/crm/customers/{_customer.Id}");
    }
}
