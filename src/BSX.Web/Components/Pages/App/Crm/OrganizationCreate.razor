@page "/app/crm/organizations/new"
@attribute [Authorize(Policy = PermissionPolicies.CrmOrganizationsCreate)]
@using BSX.BuildingBlocks.Cqrs
@using BSX.Modules.Crm.Application.Organizations.CreateOrganization
@using BSX.SharedKernel.Results
@inject ISender Sender
@inject WebCurrentUser CurrentUser
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IToastService Toasts

<PageTitle>New organization - BSX Platform</PageTitle>

<PageHeader Title="New organization"
            Subtitle="Create an organization for this workspace.">
    <Actions>
        <a class="button button-secondary" href="/app/crm/organizations">Cancel</a>
    </Actions>
</PageHeader>

<div class="content-medium">
    <Card>
        @if (_error is not null)
        {
            <div class="alert alert-error" role="alert">
                <strong>Organization could not be created.</strong>
                <span>@_error</span>
            </div>
        }

        <EditForm Model="Form" OnValidSubmit="CreateAsync">
            <DataAnnotationsValidator />
            <OrganizationFormFields Model="Form" />

            <div class="form-actions">
                <button type="submit" class="button button-primary" disabled="@_saving">
                    @(_saving ? "Creating..." : "Create organization")
                </button>
                <a class="button button-secondary" href="/app/crm/organizations">Cancel</a>
            </div>
        </EditForm>
    </Card>
</div>

@code {
    private string? _error;
    private bool _saving;

    /// <summary>The organization form model.</summary>
    public OrganizationFormModel Form { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CurrentUser.SetPrincipal(state.User);
    }

    private async Task CreateAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        _error = null;

        Result<Guid> result = await Sender.SendAsync(
            new CreateOrganizationCommand(Form.Name, Form.TaxIdentifier, Form.ToAddressInput()));

        _saving = false;

        if (result.IsFailure)
        {
            _error = CrmCustomerMessages.For(result.Error);
            return;
        }

        Toasts.Success("Organization created", "The organization is ready to use.");
        Navigation.NavigateTo($"/app/crm/organizations/{result.Value}");
    }
}
