@page "/app/crm/customers/{Id:guid}"
@attribute [Authorize(Policy = PermissionPolicies.CrmCustomersRead)]
@using BSX.BuildingBlocks.Cqrs
@using BSX.Modules.Crm.Application.Customers.GetCustomerById
@using BSX.Modules.Crm.Application.Dtos
@using BSX.Modules.Crm.Contracts.Permissions
@using BSX.SharedKernel.Results
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Http
@inject ISender Sender
@inject WebCurrentUser CurrentUser
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@(_customer?.Name ?? "Customer") - BSX Platform</PageTitle>

@if (_loading)
{
    <LoadingState Label="Loading customer..." />
}
else if (_customer is null)
{
    <PageHeader Title="Customer not found"
                Subtitle="The customer may have been removed or may belong to another workspace." />

    <Card>
        <EmptyState Title="Customer not found"
                    Description="Return to the customer list to choose another record.">
            <Action>
                <a class="button button-primary" href="/app/crm/customers">Back to customers</a>
            </Action>
        </EmptyState>
    </Card>
}
else
{
    <PageHeader Title="@_customer.Name"
                Subtitle="@($"Customer {_customer.Code}")">
        <Actions>
            <a class="button button-secondary" href="/app/crm/customers">Back to customers</a>
            @if (_canEdit)
            {
                <a class="button button-primary" href="@($"/app/crm/customers/{_customer.Id}/edit")">Edit customer</a>
            }
        </Actions>
    </PageHeader>

    @if (Created)
    {
        <div class="alert alert-success" role="status">
            Customer created successfully.
        </div>
    }
    else if (Updated)
    {
        <div class="alert alert-success" role="status">
            Customer changes saved.
        </div>
    }

    @if (_reloadError is not null)
    {
        <div class="alert alert-error" role="alert">
            <strong>The customer could not be refreshed.</strong>
            <span>@_reloadError</span>
            <button type="button" class="link-button" @onclick="ReloadCustomerAsync">Try again</button>
        </div>
    }

    <div class="detail-grid">
        <Card Title="Overview" Subtitle="Core customer information.">
            <dl class="definition-list">
                <div>
                    <dt>Customer code</dt>
                    <dd>@_customer.Code</dd>
                </div>
                <div>
                    <dt>Status</dt>
                    <dd><span class="@CustomerDisplay.StatusClass(_customer.Status)">@_customer.Status</span></dd>
                </div>
                <div>
                    <dt>Tax identifier</dt>
                    <dd>@Display(_customer.TaxIdentifier)</dd>
                </div>
            </dl>
        </Card>

        <OrganizationAssignmentCard CustomerId="_customer.Id"
                                    OrganizationId="_customer.OrganizationId"
                                    CustomerStatus="_customer.Status"
                                    CanEdit="_canEdit"
                                    CanReadOrganizations="_canReadOrganizations"
                                    OnChanged="ReloadCustomerAsync" />
    </div>

    <div class="detail-stack">
        <CustomerContactsSection Customer="_customer"
                                 CanEdit="_canEdit"
                                 OnChanged="ReloadCustomerAsync" />

        <CustomerAddressesSection Customer="_customer"
                                  CanEdit="_canEdit"
                                  OnChanged="ReloadCustomerAsync" />
    </div>
}

@code {
    private CustomerDto? _customer;
    private string? _reloadError;
    private bool _canEdit;
    private bool _canReadOrganizations;
    private bool _loading = true;

    /// <summary>The customer identifier.</summary>
    [Parameter]
    public Guid Id { get; set; }

    /// <summary>Whether the customer was just created.</summary>
    [SupplyParameterFromQuery(Name = "created")]
    public bool Created { get; set; }

    /// <summary>Whether the customer was just updated.</summary>
    [SupplyParameterFromQuery(Name = "updated")]
    public bool Updated { get; set; }

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CurrentUser.SetPrincipal(state.User);
        IReadOnlyCollection<string> permissions = NavigationCatalog.PermissionsOf(state.User);
        _canEdit = permissions.Contains(CrmPermissionCodes.CustomersUpdate, StringComparer.Ordinal);
        _canReadOrganizations = permissions.Contains(CrmPermissionCodes.OrganizationsRead, StringComparer.Ordinal);

        Result<CustomerDto> result = await Sender.SendAsync(new GetCustomerByIdQuery(Id));
        _loading = false;

        if (result.IsFailure)
        {
            if (result.Error.Code == "CRM.Customer.NotFound" && HttpContextAccessor.HttpContext is { } context)
            {
                context.Response.StatusCode = StatusCodes.Status404NotFound;
            }

            return;
        }

        _customer = result.Value;
    }

    private async Task ReloadCustomerAsync()
    {
        _reloadError = null;

        Result<CustomerDto> result = await Sender.SendAsync(new GetCustomerByIdQuery(Id));
        if (result.IsFailure)
        {
            _reloadError = CrmCustomerMessages.For(result.Error);
            return;
        }

        _customer = result.Value;
    }

    private static string Display(string? value)
        => string.IsNullOrWhiteSpace(value) ? "Not provided" : value;
}
