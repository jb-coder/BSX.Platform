@using BSX.BuildingBlocks.Cqrs
@using BSX.Modules.Crm.Application.Addresses.RemoveAddress
@using BSX.Modules.Crm.Application.Addresses.SetDefaultAddress
@using BSX.Modules.Crm.Application.Dtos
@using BSX.SharedKernel.Results
@inject ISender Sender
@inject IToastService Toasts

<Card Title="Addresses" Subtitle="Billing, shipping and other locations.">
    <Actions>
        @if (CanEdit)
        {
            <a class="button button-primary button-small"
               href="@($"/app/crm/customers/{Customer.Id}/addresses/new")">
                Add address
            </a>
        }
    </Actions>

    <ChildContent>
    @if (_error is not null)
    {
        <div class="alert alert-error" role="alert">
            <strong>Address could not be updated.</strong>
            <span>@_error</span>
            <button type="button" class="link-button" @onclick="ReloadAsync">Reload customer</button>
        </div>
    }

    @if (Customer.Addresses.Count == 0)
    {
        <EmptyState Title="No addresses yet"
                    Description="Add a billing or shipping address for this customer.">
            <Action>
                @if (CanEdit)
                {
                    <a class="button button-primary"
                       href="@($"/app/crm/customers/{Customer.Id}/addresses/new")">
                        Add the first address
                    </a>
                }
            </Action>
        </EmptyState>
    }
    else
    {
        <div class="address-grid">
            @foreach (AddressDto address in Customer.Addresses)
            {
                <article class="address-card">
                    <header>
                        <div class="address-card-title">
                            <strong>@address.Type</strong>
                            @if (address.IsDefault)
                            {
                                <span class="status-badge status-primary">Default</span>
                            }
                        </div>
                        @if (CanEdit)
                        {
                            <div class="action-row">
                                <a class="button button-quiet button-small"
                                   href="@($"/app/crm/customers/{Customer.Id}/addresses/{address.Id}/edit")"
                                   aria-label="@($"Edit {address.Type} address")">
                                    Edit
                                </a>
                                @if (!address.IsDefault)
                                {
                                    <button type="button"
                                            class="button button-quiet button-small"
                                            disabled="@_busy"
                                            aria-label="@($"Make {address.Type} address the default")"
                                            @onclick="() => SetDefaultAsync(address)">
                                        Set default
                                    </button>
                                }
                                <button type="button"
                                        class="button button-danger-ghost button-small"
                                        disabled="@_busy"
                                        aria-label="@($"Remove {address.Type} address")"
                                        @onclick="() => OpenRemoveDialog(address)">
                                    Remove
                                </button>
                            </div>
                        }
                    </header>
                    <address>
                        @foreach (string line in OrganizationDisplay.AddressLines(address))
                        {
                            @line
                            <br />
                        }
                    </address>
                </article>
            }
        </div>
    }
    </ChildContent>
</Card>

<ConfirmDialog Open="_confirmRemove"
               Title="Remove address?"
               Message="@($"Remove the {_pendingAddress?.Type.ToLowerInvariant()} address from this customer? This cannot be undone.")"
               ConfirmText="Remove address"
               Busy="_busy"
               Confirm="RemoveAsync"
               Cancel="CloseRemoveDialog" />

@code {
    private string? _error;
    private AddressDto? _pendingAddress;
    private bool _busy;
    private bool _confirmRemove;

    /// <summary>The customer whose addresses are managed.</summary>
    [Parameter, EditorRequired]
    public CustomerDto Customer { get; set; } = null!;

    /// <summary>Whether the user may change addresses.</summary>
    [Parameter]
    public bool CanEdit { get; set; }

    /// <summary>Raised after a successful mutation so the parent can reload the customer.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private void OpenRemoveDialog(AddressDto address)
    {
        _pendingAddress = address;
        _confirmRemove = true;
    }

    private void CloseRemoveDialog()
    {
        _confirmRemove = false;
        _pendingAddress = null;
    }

    private async Task SetDefaultAsync(AddressDto address)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _error = null;

        Result result = await CrmWebResults.ExecuteAsync(
            () => Sender.SendAsync(new SetDefaultAddressCommand(Customer.Id, address.Id)));

        _busy = false;

        if (result.IsFailure)
        {
            _error = CrmCustomerMessages.For(result.Error);
            return;
        }

        Toasts.Success("Default address updated", $"The {address.Type.ToLowerInvariant()} address is now the default.");
        await OnChanged.InvokeAsync();
    }

    private async Task RemoveAsync()
    {
        if (_busy || _pendingAddress is null)
        {
            return;
        }

        _busy = true;
        _error = null;

        Result result = await CrmWebResults.ExecuteAsync(
            () => Sender.SendAsync(new RemoveAddressCommand(Customer.Id, _pendingAddress.Id)));

        _busy = false;
        _confirmRemove = false;

        if (result.IsFailure)
        {
            _error = CrmCustomerMessages.For(result.Error);
            _pendingAddress = null;
            return;
        }

        Toasts.Success("Address removed", "The address was removed from the customer.");
        _pendingAddress = null;
        await OnChanged.InvokeAsync();
    }

    private Task ReloadAsync() => OnChanged.InvokeAsync();
}
