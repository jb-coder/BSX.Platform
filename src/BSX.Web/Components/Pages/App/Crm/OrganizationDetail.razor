@page "/app/crm/organizations/{Id:guid}"
@attribute [Authorize(Policy = PermissionPolicies.CrmOrganizationsRead)]
@using BSX.BuildingBlocks.Cqrs
@using BSX.Modules.Crm.Application.Dtos
@using BSX.Modules.Crm.Application.Organizations.GetOrganizationById
@using BSX.Modules.Crm.Contracts.Permissions
@using BSX.SharedKernel.Results
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Http
@inject ISender Sender
@inject WebCurrentUser CurrentUser
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@(_organization?.Name ?? "Organization") - BSX Platform</PageTitle>

@if (_loading)
{
    <LoadingState Label="Loading organization..." />
}
else if (_organization is null)
{
    <PageHeader Title="Organization not found"
                Subtitle="The organization may have been removed or may belong to another workspace." />

    <Card>
        <EmptyState Title="Organization not found"
                    Description="Return to the organization list to choose another record.">
            <Action>
                <a class="button button-primary" href="/app/crm/organizations">Back to organizations</a>
            </Action>
        </EmptyState>
    </Card>
}
else
{
    <PageHeader Title="@_organization.Name"
                Subtitle="Organization details and primary address.">
        <Actions>
            <a class="button button-secondary" href="/app/crm/organizations">Back to organizations</a>
            @if (_canEdit)
            {
                <a class="button button-primary" href="@($"/app/crm/organizations/{_organization.Id}/edit")">
                    Edit organization
                </a>
            }
        </Actions>
    </PageHeader>

    <div class="detail-grid">
        <Card Title="Overview" Subtitle="Core organization information.">
            <dl class="definition-list">
                <div>
                    <dt>Organization</dt>
                    <dd>@_organization.Name</dd>
                </div>
                <div>
                    <dt>Tax identifier</dt>
                    <dd>@Display(_organization.TaxIdentifier)</dd>
                </div>
            </dl>
        </Card>

        <Card Title="Primary address" Subtitle="Used for organization billing and correspondence.">
            @if (_organization.Address is null)
            {
                <EmptyState Title="No primary address"
                            Description="Edit the organization to add a billing or head-office address." />
            }
            else
            {
                <address class="address-block">
                    @foreach (string line in OrganizationDisplay.AddressLines(_organization.Address))
                    {
                        @line
                        <br />
                    }
                </address>
            }
        </Card>
    </div>
}

@code {
    private OrganizationDto? _organization;
    private bool _loading = true;
    private bool _canEdit;

    /// <summary>The organization identifier.</summary>
    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CurrentUser.SetPrincipal(state.User);

        _canEdit = NavigationCatalog.PermissionsOf(state.User)
            .Contains(CrmPermissionCodes.OrganizationsUpdate, StringComparer.Ordinal);

        Result<OrganizationDto> result = await Sender.SendAsync(new GetOrganizationByIdQuery(Id));
        _loading = false;

        if (result.IsFailure)
        {
            if (result.Error.Code == "CRM.Organization.NotFound" && HttpContextAccessor.HttpContext is { } context)
            {
                context.Response.StatusCode = StatusCodes.Status404NotFound;
            }

            return;
        }

        _organization = result.Value;
    }

    private static string Display(string? value)
        => string.IsNullOrWhiteSpace(value) ? "Not provided" : value;
}
