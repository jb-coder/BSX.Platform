@page "/app/sales/opportunities/{Id:guid}/edit"
@attribute [Authorize(Policy = PermissionPolicies.SalesOpportunitiesUpdate)]
@using BSX.BuildingBlocks.Cqrs
@using BSX.Modules.Crm.Contracts.Permissions
@using BSX.Modules.Sales.Application.Dtos
@using BSX.Modules.Sales.Application.Opportunities.GetOpportunityById
@using BSX.Modules.Sales.Application.Opportunities.UpdateOpportunity
@using BSX.SharedKernel.Results
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Http
@using BSX.Web.Sales
@inject ISender Sender
@inject WebCurrentUser CurrentUser
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IToastService Toasts
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Edit opportunity - BSX Platform</PageTitle>

@if (_loading)
{
    <LoadingState Label="Loading opportunity..." />
}
else if (_opportunity is null)
{
    <PageHeader Title="Opportunity not found"
                Subtitle="The opportunity may have been removed or may belong to another workspace." />

    <Card>
        <EmptyState Title="Opportunity not found"
                    Description="Return to the opportunity list to choose another record.">
            <Action>
                <a class="button button-primary" href="/app/sales/opportunities">Back to opportunities</a>
            </Action>
        </EmptyState>
    </Card>
}
else if (IsTerminal)
{
    <PageHeader Title="Opportunity is closed"
                Subtitle="Won and lost opportunities cannot be edited.">
        <Actions>
            <a class="button button-primary" href="@($"/app/sales/opportunities/{_opportunity.Id}")">
                Back to opportunity
            </a>
        </Actions>
    </PageHeader>
}
else
{
    <PageHeader Title="@($"Edit {_opportunity.Title}")"
                Subtitle="Update the revenue forecast and CRM references.">
        <Actions>
            <a class="button button-secondary" href="@($"/app/sales/opportunities/{_opportunity.Id}")">Cancel</a>
        </Actions>
    </PageHeader>

    <div class="content-medium">
        @if (_error is not null)
        {
            <div class="alert alert-error" role="alert">
                <strong>Changes could not be saved.</strong>
                <span>@_error</span>
                @if (_conflict)
                {
                    <a href="@($"/app/sales/opportunities/{_opportunity.Id}/edit")">Reload opportunity</a>
                }
            </div>
        }

        <Card>
            @if (!_canReadCustomers)
            {
                <div class="alert alert-warning" role="status">
                    CRM customer read permission is required to change the customer reference.
                </div>
            }

            <EditForm Model="Form" OnValidSubmit="UpdateAsync">
                <DataAnnotationsValidator />
                <OpportunityFormFields Model="Form"
                                       ShowOrganization="true"
                                       CanReadCustomers="_canReadCustomers"
                                       CanReadOrganizations="_canReadOrganizations" />

                <div class="form-actions">
                    <button type="submit" class="button button-primary" disabled="@(_saving || !_canReadCustomers)">
                        @(_saving ? "Saving..." : "Save changes")
                    </button>
                    <a class="button button-secondary" href="@($"/app/sales/opportunities/{_opportunity.Id}")">
                        Cancel
                    </a>
                </div>
            </EditForm>
        </Card>
    </div>
}

@code {
    private OpportunityDto? _opportunity;
    private string? _error;
    private bool _loading = true;
    private bool _saving;
    private bool _conflict;
    private bool _canReadCustomers;
    private bool _canReadOrganizations;

    /// <summary>The opportunity identifier.</summary>
    [Parameter]
    public Guid Id { get; set; }

    /// <summary>The opportunity form model.</summary>
    public OpportunityFormModel Form { get; set; } = new();

    private bool IsTerminal => _opportunity?.Stage is "Won" or "Lost";

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CurrentUser.SetPrincipal(state.User);
        IReadOnlyCollection<string> permissions = NavigationCatalog.PermissionsOf(state.User);
        _canReadCustomers = permissions.Contains(CrmPermissionCodes.CustomersRead, StringComparer.Ordinal);
        _canReadOrganizations = permissions.Contains(CrmPermissionCodes.OrganizationsRead, StringComparer.Ordinal);

        Result<OpportunityDto> result = await Sender.SendAsync(new GetOpportunityByIdQuery(Id));
        _loading = false;

        if (result.IsFailure)
        {
            if (result.Error.Code == "SALES.Opportunity.NotFound" && HttpContextAccessor.HttpContext is { } context)
            {
                context.Response.StatusCode = StatusCodes.Status404NotFound;
            }

            return;
        }

        _opportunity = result.Value;
        Form = new OpportunityFormModel
        {
            Title = _opportunity.Title,
            CustomerId = _opportunity.CustomerId,
            OrganizationId = _opportunity.OrganizationId,
            Amount = _opportunity.Amount,
            Currency = _opportunity.Currency,
            Probability = _opportunity.Probability,
            ExpectedCloseDate = _opportunity.ExpectedCloseDate,
        };
    }

    private async Task UpdateAsync()
    {
        if (_saving || _opportunity is null || Form.CustomerId is not { } customerId)
        {
            return;
        }

        _saving = true;
        _error = null;
        _conflict = false;

        Result result = await SalesWebResults.ExecuteAsync(() => Sender.SendAsync(
            new UpdateOpportunityCommand(
                _opportunity.Id,
                customerId,
                Form.OrganizationId,
                Form.Title,
                Form.Amount,
                Form.Currency,
                Form.Probability,
                Form.ExpectedCloseDate)));

        _saving = false;

        if (result.IsFailure)
        {
            _conflict = result.Error.Code == "SALES.ConcurrencyConflict";
            _error = SalesMessages.For(result.Error);
            return;
        }

        Toasts.Success("Opportunity saved", "The opportunity forecast was updated.");
        Navigation.NavigateTo($"/app/sales/opportunities/{_opportunity.Id}");
    }
}
