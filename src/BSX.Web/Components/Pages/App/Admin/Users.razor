@page "/app/admin/users"
@attribute [Authorize(Policy = PermissionPolicies.IdentityUsersRead)]
@using System.Globalization
@using BSX.BuildingBlocks.Cqrs
@using BSX.Modules.Identity.Application.Dtos
@using BSX.Modules.Identity.Application.Users.ListUsers
@using BSX.SharedKernel.Results
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using BSX.Web.Administration
@inject AdministrationDispatcher Dispatcher
@inject WebCurrentUser CurrentUser
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Users - BSX Platform</PageTitle>

<PageHeader Title="Users"
            Subtitle="Manage user accounts and their lifecycle.">
    <Actions>
        @if (_canCreate)
        {
            <a class="button button-primary" href="/app/admin/users/new">New user</a>
        }
    </Actions>
</PageHeader>

<Card>
    <div class="list-toolbar">
        <form method="get" action="/app/admin/users" role="search" class="list-search">
            <SearchBox Name="search"
                       @bind-Value="Search"
                       Label="Search users"
                       Placeholder="Search by name or email"
                       ShowClearButton="false" />
            <input type="hidden" name="size" value="@PageSize" />
            <button type="submit" class="button button-secondary">Search</button>
            @if (!string.IsNullOrWhiteSpace(Search))
            {
                <a class="button button-quiet" href="/app/admin/users">Clear</a>
            }
        </form>
    </div>

    @if (_loading)
    {
        <LoadingState Label="Loading users..." />
    }
    else if (_error is not null)
    {
        <ErrorState Title="Users could not be loaded" Message="@_error">
            <Action>
                <a class="button button-secondary" href="@CurrentUrl">Try again</a>
            </Action>
        </ErrorState>
    }
    else if (_result is not null)
    {
        <p class="result-summary" aria-live="polite">@ResultSummary</p>

        @if (_result.Items.Count == 0)
        {
            <EmptyState Title="@EmptyTitle" Description="@EmptyDescription">
                <Action>
                    @if (_canCreate)
                    {
                        <a class="button button-primary" href="/app/admin/users/new">Create a user</a>
                    }
                </Action>
            </EmptyState>
        }
        else
        {
            <DataTable Items="_result.Items" Caption="User results">
                <HeaderTemplate>
                    <th scope="col">Name</th>
                    <th scope="col">Email</th>
                    <th scope="col">Status</th>
                </HeaderTemplate>
                <RowTemplate Context="user">
                    <td>
                        <a class="table-link" href="@($"/app/admin/users/{user.Id}")">@user.Name</a>
                    </td>
                    <td>@user.Email</td>
                    <td><span class="@AdministrationDisplay.UserStatusClass(user.Status)">@user.Status</span></td>
                </RowTemplate>
            </DataTable>

            <Pagination Page="_result.Page"
                        PageSize="_result.Size"
                        TotalCount="_result.TotalCount"
                        PageHrefFactory="BuildPageUrl" />
        }
    }
</Card>

@code {
    private PagedResult<UserSummaryDto>? _result;
    private string? _error;
    private bool _loading = true;
    private bool _canCreate;

    /// <summary>The requested one-based page.</summary>
    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    /// <summary>The requested page size.</summary>
    [SupplyParameterFromQuery(Name = "size")]
    public int PageSize { get; set; } = 20;

    /// <summary>The optional name/email search term.</summary>
    [SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; }

    private string CurrentUrl => BuildPageUrl(Page);

    private string ResultSummary => _result!.TotalCount == 1 ? "1 user" : $"{_result.TotalCount:N0} users";

    private string EmptyTitle => string.IsNullOrWhiteSpace(Search) ? "No users yet" : "No users match your search";

    private string EmptyDescription => string.IsNullOrWhiteSpace(Search)
        ? "Create a user account first, then invite the person to this workspace from Memberships."
        : $"No user name or email contains \"{Search.Trim()}\".";

    protected override async Task OnParametersSetAsync()
    {
        AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CurrentUser.SetPrincipal(state.User);

        _loading = true;
        _error = null;
        _canCreate = NavigationCatalog.PermissionsOf(state.User)
            .Contains(IdentityPermissionCodes.UsersCreate, StringComparer.Ordinal);

        Result<PagedResult<UserSummaryDto>> result = await Dispatcher.SendAsync(
            new ListUsersQuery(Page, PageSize, Search));

        _loading = false;

        if (result.IsFailure)
        {
            _error = IdentityMessages.For(result.Error);
            return;
        }

        _result = result.Value;
        Page = result.Value.Page;
        PageSize = result.Value.Size;
    }

    private string BuildPageUrl(int page)
    {
        var query = new Dictionary<string, string?>
        {
            ["page"] = page.ToString(CultureInfo.InvariantCulture),
        };

        if (!string.IsNullOrWhiteSpace(Search))
        {
            query["search"] = Search.Trim();
        }

        if (PageSize > 0)
        {
            query["size"] = PageSize.ToString(CultureInfo.InvariantCulture);
        }

        return QueryHelpers.AddQueryString("/app/admin/users", query);
    }
}
