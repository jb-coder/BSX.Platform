@page "/app/admin/users/{Id:guid}/edit"
@attribute [Authorize(Policy = PermissionPolicies.IdentityUsersUpdate)]
@using BSX.BuildingBlocks.Cqrs
@using BSX.Modules.Identity.Application.Dtos
@using BSX.Modules.Identity.Application.Users.GetUserById
@using BSX.Modules.Identity.Application.Users.UpdateUser
@using BSX.SharedKernel.Results
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Http
@using BSX.Web.Administration
@inject AdministrationDispatcher Dispatcher
@inject WebCurrentUser CurrentUser
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IToastService Toasts
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Edit user - BSX Platform</PageTitle>

@if (_loading)
{
    <LoadingState Label="Loading user..." />
}
else if (_user is null)
{
    <PageHeader Title="User not found"
                Subtitle="The user may have been removed." />

    <Card>
        <EmptyState Title="User not found"
                    Description="Return to the user list to choose another account.">
            <Action>
                <a class="button button-primary" href="/app/admin/users">Back to users</a>
            </Action>
        </EmptyState>
    </Card>
}
else
{
    <PageHeader Title="@($"Edit {_user.Name}")"
                Subtitle="Update the user's name and email address.">
        <Actions>
            <a class="button button-secondary" href="@($"/app/admin/users/{_user.Id}")">Cancel</a>
        </Actions>
    </PageHeader>

    <div class="content-medium">
        @if (_error is not null)
        {
            <div class="alert alert-error" role="alert">
                <strong>Changes could not be saved.</strong>
                <span>@_error</span>
                @if (_conflict)
                {
                    <a href="@($"/app/admin/users/{_user.Id}/edit")">Reload user</a>
                }
            </div>
        }

        <Card>
            <EditForm Model="Form" OnValidSubmit="UpdateAsync">
                <DataAnnotationsValidator />
                <FormSection Title="Account details">
                    <div class="field">
                        <label for="user-name">Display name</label>
                        <InputText id="user-name" @bind-Value="Form.Name" autocomplete="name" />
                        <ValidationMessage For="@(() => Form.Name)" />
                    </div>

                    <div class="field">
                        <label for="user-email">Email address</label>
                        <InputText id="user-email"
                                   type="email"
                                   @bind-Value="Form.Email"
                                   autocomplete="email"
                                   inputmode="email" />
                        <ValidationMessage For="@(() => Form.Email)" />
                    </div>
                </FormSection>

                <div class="form-actions">
                    <button type="submit" class="button button-primary" disabled="@_saving">
                        @(_saving ? "Saving..." : "Save changes")
                    </button>
                    <a class="button button-secondary" href="@($"/app/admin/users/{_user.Id}")">Cancel</a>
                </div>
            </EditForm>
        </Card>
    </div>
}

@code {
    private UserDto? _user;
    private string? _error;
    private bool _loading = true;
    private bool _saving;
    private bool _conflict;

    /// <summary>The user identifier.</summary>
    [Parameter]
    public Guid Id { get; set; }

    /// <summary>The edit-user form model.</summary>
    public UserEditFormModel Form { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CurrentUser.SetPrincipal(state.User);

        Result<UserDto> result = await Dispatcher.SendAsync(new GetUserByIdQuery(Id));
        _loading = false;

        if (result.IsFailure)
        {
            if (result.Error.Code == "Identity.User.NotFound" && HttpContextAccessor.HttpContext is { } context)
            {
                context.Response.StatusCode = StatusCodes.Status404NotFound;
            }

            return;
        }

        _user = result.Value;
        Form = new UserEditFormModel { Name = _user.Name, Email = _user.Email };
    }

    private async Task UpdateAsync()
    {
        if (_saving || _user is null)
        {
            return;
        }

        _saving = true;
        _error = null;
        _conflict = false;

        Result result = await IdentityWebResults.ExecuteAsync(() => Dispatcher.SendAsync(
            new UpdateUserCommand(_user.Id, Form.Name, Form.Email)));

        _saving = false;

        if (result.IsFailure)
        {
            _conflict = result.Error.Code == "Identity.Concurrency.Conflict";
            _error = IdentityMessages.For(result.Error);
            return;
        }

        Toasts.Success("User saved", "The user profile was updated.");
        Navigation.NavigateTo($"/app/admin/users/{_user.Id}");
    }
}
