@page "/app/admin/roles/{Id:guid}/edit"
@attribute [Authorize(Policy = PermissionPolicies.IdentityRolesUpdate)]
@using BSX.BuildingBlocks.Cqrs
@using BSX.Modules.Identity.Application.Dtos
@using BSX.Modules.Identity.Application.Roles.GetRoleById
@using BSX.Modules.Identity.Application.Roles.UpdateRole
@using BSX.SharedKernel.Results
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Http
@using BSX.Web.Administration
@inject AdministrationDispatcher Dispatcher
@inject WebCurrentUser CurrentUser
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IToastService Toasts
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Edit role - BSX Platform</PageTitle>

@if (_loading)
{
    <LoadingState Label="Loading role..." />
}
else if (_role is null)
{
    <PageHeader Title="Role not found" Subtitle="The role may have been removed." />
    <Card>
        <EmptyState Title="Role not found" Description="Return to the role list.">
            <Action><a class="button button-primary" href="/app/admin/roles">Back to roles</a></Action>
        </EmptyState>
    </Card>
}
else if (_role.IsSystem)
{
    <PageHeader Title="System role" Subtitle="System roles are managed by the platform and cannot be edited.">
        <Actions><a class="button button-secondary" href="@($"/app/admin/roles/{_role.Id}")">Back to role</a></Actions>
    </PageHeader>
}
else
{
    <PageHeader Title="@($"Edit {_role.Name}")" Subtitle="Update the role name and description.">
        <Actions><a class="button button-secondary" href="@($"/app/admin/roles/{_role.Id}")">Cancel</a></Actions>
    </PageHeader>

    <div class="content-medium">
        @if (_error is not null)
        {
            <div class="alert alert-error" role="alert">
                <strong>Changes could not be saved.</strong>
                <span>@_error</span>
                @if (_conflict)
                {
                    <a href="@($"/app/admin/roles/{_role.Id}/edit")">Reload role</a>
                }
            </div>
        }

        <Card>
            <EditForm Model="Form" OnValidSubmit="UpdateAsync">
                <DataAnnotationsValidator />
                <FormSection Title="Role details">
                    <div class="field">
                        <label for="role-name">Role name</label>
                        <InputText id="role-name" @bind-Value="Form.Name" />
                        <ValidationMessage For="@(() => Form.Name)" />
                    </div>
                    <div class="field">
                        <label for="role-description">Description <span class="field-optional">Optional</span></label>
                        <InputTextArea id="role-description" @bind-Value="Form.Description" rows="3" />
                        <ValidationMessage For="@(() => Form.Description)" />
                    </div>
                </FormSection>

                <div class="form-actions">
                    <button type="submit" class="button button-primary" disabled="@_saving">
                        @(_saving ? "Saving..." : "Save changes")
                    </button>
                    <a class="button button-secondary" href="@($"/app/admin/roles/{_role.Id}")">Cancel</a>
                </div>
            </EditForm>
        </Card>
    </div>
}

@code {
    private RoleDto? _role;
    private string? _error;
    private bool _loading = true;
    private bool _saving;
    private bool _conflict;

    /// <summary>The role identifier.</summary>
    [Parameter]
    public Guid Id { get; set; }

    /// <summary>The role form model.</summary>
    public RoleFormModel Form { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CurrentUser.SetPrincipal(state.User);

        Result<RoleDto> result = await Dispatcher.SendAsync(new GetRoleByIdQuery(Id));
        _loading = false;

        if (result.IsFailure)
        {
            if (result.Error.Code == "Identity.Role.NotFound" && HttpContextAccessor.HttpContext is { } context)
            {
                context.Response.StatusCode = StatusCodes.Status404NotFound;
            }

            return;
        }

        _role = result.Value;
        Form = new RoleFormModel { Name = _role.Name, Description = _role.Description };
    }

    private async Task UpdateAsync()
    {
        if (_saving || _role is null)
        {
            return;
        }

        _saving = true;
        _error = null;
        _conflict = false;

        Result result = await IdentityWebResults.ExecuteAsync(() => Dispatcher.SendAsync(
            new UpdateRoleCommand(_role.Id, Form.Name, Form.Description)));

        _saving = false;

        if (result.IsFailure)
        {
            _conflict = result.Error.Code == "Identity.Concurrency.Conflict";
            _error = IdentityMessages.For(result.Error);
            return;
        }

        Toasts.Success("Role saved", "The role details were updated.");
        Navigation.NavigateTo($"/app/admin/roles/{_role.Id}");
    }
}
