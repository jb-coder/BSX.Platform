@page "/app/admin/memberships/{Id:guid}/role"
@attribute [Authorize(Policy = PermissionPolicies.IdentityMembershipsManage)]
@using BSX.BuildingBlocks.Cqrs
@using BSX.Modules.Identity.Application.Dtos
@using BSX.Modules.Identity.Application.Memberships.ChangeMembershipRole
@using BSX.Modules.Identity.Application.Memberships.ListTenantMemberships
@using BSX.Modules.Identity.Application.Roles.ListRoles
@using BSX.SharedKernel.Results
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Http
@using BSX.Web.Administration
@inject AdministrationDispatcher Dispatcher
@inject WebCurrentUser CurrentUser
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IToastService Toasts
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Change membership role - BSX Platform</PageTitle>

@if (_loading)
{
    <LoadingState Label="Loading membership..." />
}
else if (_membership is null)
{
    <PageHeader Title="Membership not found" Subtitle="The membership may have been removed." />
    <Card>
        <EmptyState Title="Membership not found" Description="Return to the membership list.">
            <Action><a class="button button-primary" href="/app/admin/memberships">Back to memberships</a></Action>
        </EmptyState>
    </Card>
}
else
{
    <PageHeader Title="@($"Change role · {_membership.Name}")"
                Subtitle="Assign one workspace or platform role to this member.">
        <Actions><a class="button button-secondary" href="/app/admin/memberships">Cancel</a></Actions>
    </PageHeader>

    <div class="content-medium">
        @if (_error is not null)
        {
            <div class="alert alert-error" role="alert">
                <strong>The role could not be changed.</strong>
                <span>@_error</span>
                @if (_conflict)
                {
                    <a href="@($"/app/admin/memberships/{_membership.Id}/role")">Reload membership</a>
                }
            </div>
        }

        <Card>
            <dl class="definition-list">
                <div>
                    <dt>Member</dt>
                    <dd>@_membership.Name · @_membership.Email</dd>
                </div>
                <div>
                    <dt>Current roles</dt>
                    <dd>@(_membership.RoleNames.Count == 0 ? "No role" : string.Join(", ", _membership.RoleNames))</dd>
                </div>
            </dl>

            <div class="field">
                <label for="membership-role">Role</label>
                <InputSelect id="membership-role" @bind-Value="_selectedRoleId">
                    <option value="">No role</option>
                    @foreach (RoleDto role in _roles)
                    {
                        <option value="@role.Id">@role.Name · @(role.TenantId is null ? "Platform" : "Workspace")</option>
                    }
                </InputSelect>
                <span class="field-hint">Changing the role replaces the member's current role assignment.</span>
            </div>

            <div class="form-actions">
                <button type="button" class="button button-primary" disabled="@_saving" @onclick="SaveAsync">
                    @(_saving ? "Saving..." : "Save role")
                </button>
                <a class="button button-secondary" href="/app/admin/memberships">Cancel</a>
            </div>
        </Card>
    </div>
}

@code {
    private MembershipDto? _membership;
    private IReadOnlyList<RoleDto> _roles = [];
    private string _selectedRoleId = string.Empty;
    private string? _error;
    private bool _loading = true;
    private bool _saving;
    private bool _conflict;

    /// <summary>The membership identifier.</summary>
    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CurrentUser.SetPrincipal(state.User);

        Result<IReadOnlyList<MembershipDto>> memberships = await Dispatcher.SendAsync(
            new ListTenantMembershipsQuery());

        Result<IReadOnlyList<RoleDto>> tenantRoles = await Dispatcher.SendAsync(
            new ListRolesQuery(CurrentUser.TenantId));
        Result<IReadOnlyList<RoleDto>> systemRoles = await Dispatcher.SendAsync(
            new ListRolesQuery(null));

        _loading = false;

        if (memberships.IsFailure)
        {
            _error = IdentityMessages.For(memberships.Error);
            return;
        }

        _membership = memberships.Value.FirstOrDefault(membership => membership.Id == Id);

        if (_membership is null)
        {
            if (HttpContextAccessor.HttpContext is { } context)
            {
                context.Response.StatusCode = StatusCodes.Status404NotFound;
            }

            return;
        }

        if (tenantRoles.IsSuccess && systemRoles.IsSuccess)
        {
            _roles = tenantRoles.Value
                .Concat(systemRoles.Value)
                .OrderByDescending(role => role.IsSystem)
                .ThenBy(role => role.Name, StringComparer.OrdinalIgnoreCase)
                .ToArray();
        }
        else if (tenantRoles.IsFailure)
        {
            _error = IdentityMessages.For(tenantRoles.Error);
        }
        else if (systemRoles.IsFailure)
        {
            _error = IdentityMessages.For(systemRoles.Error);
        }

        _selectedRoleId = _membership.RoleIds.Count > 0
            ? _membership.RoleIds[0].ToString()
            : string.Empty;
    }

    private async Task SaveAsync()
    {
        if (_saving || _membership is null)
        {
            return;
        }

        Guid? roleId = null;
        if (!string.IsNullOrWhiteSpace(_selectedRoleId))
        {
            if (!Guid.TryParse(_selectedRoleId, out Guid parsed))
            {
                _error = "Select a valid role.";
                return;
            }

            roleId = parsed;
        }

        _saving = true;
        _error = null;
        _conflict = false;

        Result result = await IdentityWebResults.ExecuteAsync(() => Dispatcher.SendAsync(
            new ChangeMembershipRoleCommand(_membership.Id, roleId)));

        _saving = false;

        if (result.IsFailure)
        {
            _conflict = result.Error.Code == "Identity.Concurrency.Conflict";
            _error = IdentityMessages.For(result.Error);
            return;
        }

        Toasts.Success("Membership role updated", "The member's role assignment was changed.");
        Navigation.NavigateTo("/app/admin/memberships");
    }
}
