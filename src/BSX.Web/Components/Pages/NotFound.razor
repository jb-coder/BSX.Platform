@page "/not-found"
@layout AuthLayout

<PageTitle>Not found - BSX Platform</PageTitle>

<div class="auth-page auth-page-single">
    <section class="auth-card auth-card-wide" aria-labelledby="not-found-title">
        <Brand />
        <div class="auth-card-heading">
            <p class="eyebrow">404</p>
            <h1 id="not-found-title">We could not find that page</h1>
            <p>The page may have moved, or the address may be incorrect.</p>
        </div>
        <a class="button button-primary" href="/">Go to your workspace</a>
    </section>
</div>
